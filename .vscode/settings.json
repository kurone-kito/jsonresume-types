{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*": "${capture}.meta, ${capture}.md5",
    "*.md": "${capture}.*.md",
    ".gitattributes": ".gitignore",
    ".tool-versions": ".node-version, .nvmrc",
    "package.json": "package-lock.json"
  },
  "files.readonlyInclude": {
    "**/*.d.ts": true,
    "**/*.tgz": true,
    "**/.husky*": true,
    "**/node_modules/**/*": true
  },
  "files.watcherExclude": {
    "**/*.d.ts": true,
    "**/*.tgz": true,
    "**/.husky*": true,
    "**/node_modules/**/*": true
  },
  "git.branchProtection": ["master"],
  "search.exclude": {
    "**/*.d.ts": true,
    "**/.husky*": true,
    "**/node_modules/**/*": true
  },
  "yaml.schemas": {
    "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json": [
      "cspell.config.yml"
    ],
    "https://storage.googleapis.com/coderabbit_public_assets/schema.v2.json": [
      ".coderabbit.yaml"
    ]
  }
}
